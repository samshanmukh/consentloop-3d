{
  "name": "consentloop-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "bots/*"
  ],
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:app && npm run test:fhir",
    "test:app": "npm run build && node --import tsx --test tests/rendered-html.test.mjs tests/anatomy-contract.test.ts tests/deepgram-token.test.ts tests/voice-agent.test.ts",
    "build:fhir": "tsc -p tsconfig.fhir.json",
    "test:fhir": "npm run build:fhir && node --test dist/tests/*.test.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "selftest": "tsx scripts/selftest.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "seed:demo": "npm run build:fhir && node --env-file-if-exists=.env dist/scripts/seed-demo.js",
    "deploy:prepare": "npm run build:fhir && node --env-file-if-exists=.env dist/scripts/deploy-prepare.js",
    "smoke:prepare": "npm run build:fhir && node --env-file-if-exists=.env dist/scripts/smoke-prepare.js",
    "reset": "tsx scripts/reset-demo.ts",
    "create-order": "tsx scripts/create-service-request.ts",
    "deploy:bots": "tsx scripts/deploy-bots.ts",
    "setup:subscriptions": "tsx scripts/setup-subscriptions.ts",
    "verify": "tsx scripts/verify-flow.ts",
    "check-env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@deepgram/agents": "^0.1.1",
    "@medplum/bot-layer": "5.1.27",
    "@medplum/core": "5.1.27",
    "@medplum/fhirtypes": "5.1.27",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "tsx": "^4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
